# /etc/nginx/sites-available/mcp.plus-tard.com
#
# After installing this file:
#   sudo ln -s /etc/nginx/sites-available/mcp.plus-tard.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Get the TLS cert with certbot (see deploy/README.md for full steps):
#   sudo certbot --nginx -d mcp.plus-tard.com

# HTTP -> HTTPS redirect.
server {
    listen 80;
    listen [::]:80;
    server_name mcp.plus-tard.com;

    # Allow ACME http-01 challenges.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS endpoint proxying to the MCP container on 127.0.0.1:8001.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mcp.plus-tard.com;

    # certbot will fill these in (or replace if you manage certs manually).
    ssl_certificate     /etc/letsencrypt/live/mcp.plus-tard.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.plus-tard.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Reasonable defaults for a JSON+SSE service.
    client_max_body_size 10m;

    # ---- MCP-specific: SSE / Streamable HTTP ----
    # The MCP transport keeps connections open and streams events.
    # Disable buffering and bump timeouts so streamed events flow through.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;

    # Standard reverse-proxy headers.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # The X-Api-Key header carries the per-user Plus Tard token; pass it through.
    proxy_pass_request_headers on;

    location / {
        proxy_pass http://127.0.0.1:8001;
    }
}
